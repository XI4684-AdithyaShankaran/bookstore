DATABASE_URL=postgresql://bookstore_user:bookstore_pass@localhost:5432/bookstore_db
POSTGRES_DB=bookstore_db
POSTGRES_USER=bookstore_user
POSTGRES_PASSWORD=bookstore_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis used by backend and ai-service; server configured via redis/redis.conf
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=bookstore_redis_pass

# Vector DB and LLM
WEAVIATE_URL=http://localhost:8080
GEMINI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Kaggle (only needed if you want to auto-download dataset)
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET_ID=saurabhbagchi/books-dataset
KAGGLE_DATASET_VERSION=1

# App secrets and frontend auth
SECRET_KEY=dev-secret-key
NEXTAUTH_SECRET=dev-nextauth-secret-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Payments (India-first)
# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# PayU
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Stripe (keep until frontend is migrated)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
 
# GCP for queues, Cloud SQL proxy/dev, BigQuery (optional locally)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
CLOUDSQL_CONNECTION_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_DATASET=
BIGQUERY_TABLE=

# GCS (Google Cloud Storage)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=